<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The laser's own socket to the phone app (DirectLink); optional, the
         laser goes over the Data Layer without it. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Ambient mode (AmbientLifecycleObserver). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- PresentingService: the remote as an Ongoing Activity while a show
         runs. A connectedDevice service needs one of a list of permissions;
         CHANGE_NETWORK_STATE is granted with the app. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".QuickRemoteWearApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuickRemote">

        <!-- Not standalone: the watch reaches the computer through the phone
             app (the Wearable Data Layer), which holds the connection. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".PresentingService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- The talk's clock warnings, vibrated also while the remote is not
             on screen. -->
        <service
            android:name=".phone.AlertService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:path="/quickremote/alert" />
            </intent-filter>
        </service>

    </application>
</manifest>
